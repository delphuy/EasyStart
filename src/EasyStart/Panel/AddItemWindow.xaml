<Window x:Class="EasyStart.Panel.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快捷项"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="OnWinKeyDown">
    <!-- 比「编辑快捷项」小一圈：叠在编辑窗上能看到下层边框，层次分明 -->
    <Grid Margin="12">
        <Border x:Name="DialogRoot" CornerRadius="12"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundLightBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题（拖动把手） + 右上角 ✕ 关闭 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                        <TextBlock Text="添加快捷项" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Border>
                    <Button Grid.Column="1" Content="✕" Width="30" Height="28"
                            FontSize="13" Padding="0" ToolTip="关闭（Esc）"
                            Click="OnCloseRequest" />
                </Grid>

                <!-- 三页签：自定义置首（辉哥哥 2026-10-28），后装程序、系统功能 -->
                <TabControl x:Name="ModeTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">

                    <!-- 页签 1：自定义（标签列 64 定宽，控件全部同一起排线） -->
                    <TabItem Header="自定义">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 类型 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" FontSize="12" Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <ComboBox x:Name="CustomType" Grid.Row="0" Grid.Column="1" Height="34" Width="220"
                                      HorizontalAlignment="Left" SelectionChanged="OnCustomTypeChanged">
                                <ComboBoxItem Content="程序" />
                                <ComboBoxItem Content="文件" />
                                <ComboBoxItem Content="网址" />
                            </ComboBox>

                            <!-- 路径 / 网址 -->
                            <TextBlock x:Name="CustomPathLabel" Grid.Row="1" Grid.Column="0" Text="路径" FontSize="12"
                                       Opacity="0.7" Margin="0,14,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="6" BorderThickness="1" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <TextBox x:Name="CustomPath" Height="34" Padding="8" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             LostFocus="OnCustomPathLostFocus" />
                                </Border>
                                <Button x:Name="CustomBrowse" Grid.Column="1" Content="浏览…" Width="80" Height="34"
                                        Click="OnBrowse" />
                            </Grid>

                            <!-- 图标：预览 + 选图/恢复按钮同一行，高度统一 34 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="图标" FontSize="12" Opacity="0.7"
                                       Margin="0,14,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="6" BorderThickness="1" Width="40" Height="40"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <Image x:Name="CustomIcon" Width="30" Height="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="CustomPickIcon" Content="选择图标…" Width="96" Height="34"
                                        Margin="10,0,6,0" VerticalAlignment="Center" Click="OnPickIcon" />
                                <Button x:Name="CustomResetIcon" Content="恢复默认" Width="80" Height="34"
                                        VerticalAlignment="Center" Click="OnResetIcon" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontSize="11" Opacity="0.55"
                                       Text="网址图标自动取网站 favicon（取不到用站点字母头像），也可自行选择图标文件"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                            <!-- 名称 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="名称" FontSize="12" Opacity="0.7"
                                       Margin="0,14,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Border Grid.Row="4" Grid.Column="1" CornerRadius="6" BorderThickness="1"
                                    Margin="0,14,0,0" Width="360" HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <TextBox x:Name="CustomName" Height="34" Padding="8" FontSize="13"
                                         BorderThickness="0" Background="Transparent" />
                            </Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" FontSize="11" Opacity="0.55"
                                       Text="名称按路径自动带出，可改"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        </Grid>
                    </TabItem>

                    <!-- 页签 2：已安装的应用程序 -->
                    <TabItem Header="已安装的应用程序">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <CheckBox x:Name="AppSelectAll" Content="全选" HorizontalAlignment="Right"
                                          FontSize="12" Checked="OnAppSelectAllChecked" Unchecked="OnAppSelectAllChecked"
                                          ToolTip="勾选/取消勾选全部程序" />
                            </Grid>
                            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <ListView x:Name="AppList" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="40">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Icon}" Width="24" Height="24"
                                                               VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="170" Header="名称">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NameText}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip="{Binding NameText}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="64" Header="类型">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TypeText}" FontSize="12" Opacity="0.75"
                                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="220" Header="路径">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding PathText}" FontSize="12" Opacity="0.75"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip="{Binding PathText}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 页签 3：系统功能（条列多选 + 全选） -->
                    <TabItem Header="系统功能">
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SysSelectAll" DockPanel.Dock="Top" Content="全选" Margin="0,0,0,8"
                                      FontSize="12" HorizontalAlignment="Right" Checked="OnSysSelectAllChecked" Unchecked="OnSysSelectAllChecked"
                                      ToolTip="勾选/取消勾选全部系统功能" />
                            <Border CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SysList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="10,7">
                                                    <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                                           Margin="12,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding NameText}" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- 底部 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock x:Name="TargetTabText" VerticalAlignment="Center" FontSize="12" Opacity="0.75"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Content="取消" Width="80" Height="34" Margin="0,0,8,0"
                                Click="OnCancel" />
                        <Button x:Name="ConfirmBtn" Content="确定" Width="88" Height="34"
                                Background="DodgerBlue" Foreground="White"
                                Click="OnConfirm" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
