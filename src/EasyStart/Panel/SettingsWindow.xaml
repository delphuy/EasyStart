<Window x:Class="EasyStart.Panel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="OnWinKeyDown">
    <!-- 与编辑/添加窗同款：无边框圆角 + 投影 + ✕/Esc（辉哥哥 2026-10-28：设置窗要跟其他弹窗一个风格） -->
    <Grid Margin="12">
        <Border x:Name="DialogRoot" CornerRadius="12"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundLightBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Grid Margin="18,14,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题（拖动把手） + ✕ -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                        <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    </Border>
                    <Button Grid.Column="1" Content="✕" Width="30" Height="28"
                            FontSize="13" Padding="0" ToolTip="关闭（Esc）"
                            Click="OnClose" />
                </Grid>

                <!-- 2026-10-28（辉哥哥：设置界面不要滚动条）：去 ScrollViewer，窗口随内容自适应高度 -->
                <StackPanel Grid.Row="1">

                        <!-- ============ 呼出 / 隐藏 ============ -->
                        <TextBlock Text="呼出 / 隐藏" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <Border x:Name="HotkeyBox" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                Height="38" Margin="0,0,0,10"
                                Background="Transparent"
                                Cursor="Hand"
                                ToolTip="点一下，然后按下你想用的组合键（如 Ctrl+Alt+X）">
                            <Grid>
                                <TextBlock x:Name="HotkeyText"
                                           Text="点我后按快捷键" FontSize="13"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           HorizontalAlignment="Left" />
                                <TextBlock x:Name="HotkeyHint"
                                           Text="Esc 清除" FontSize="11" Opacity="0.55"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <CheckBox x:Name="MiddleClickCheck" Content="鼠标中键呼出"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="HideOnDeactivatedCheck" Content="失焦自动隐藏"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="CtrlHoldCheck" Content="按住 Ctrl 时不隐藏"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                        <!-- ============ 标签切换 ============ -->
                        <TextBlock Text="标签切换" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                                   Margin="0,12,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="NumberCheck" Content="数字键切换标签 / 启动项"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="WheelCheck" Content="滚轮切换标签"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="CirculateCheck" Content="滚轮循环切换"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="HoverCheck" Content="悬停切换标签"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                        <!-- ============ 外观（标签列 72 定宽：下拉框/滑块全部同一起排线） ============ -->
                        <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                                   Margin="0,12,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主题" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="160" Height="32"
                                      FontSize="13" Padding="8,4" HorizontalAlignment="Left">
                                <ComboBoxItem Content="纯色浅色" />
                                <ComboBoxItem Content="纯色深色" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="图标尺寸" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <ComboBox x:Name="IconSizeBox" Grid.Column="1" Width="120" Height="32"
                                      FontSize="13" Padding="8,4" HorizontalAlignment="Left">
                                <ComboBoxItem Content="小（32）" Tag="0" />
                                <ComboBoxItem Content="中（48）" Tag="1" />
                                <ComboBoxItem Content="大（64）" Tag="2" />
                                <ComboBoxItem Content="特大（96）" Tag="3" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="不透明度" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="OpacitySlider" Width="200" Minimum="0.3" Maximum="1.0"
                                        SmallChange="0.01" LargeChange="0.01"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="OnOpacitySliderClick" />
                                <TextBlock x:Name="OpacityValueText" Width="40" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="1.00" TextAlignment="Left" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- ============ 系统 ============ -->
                        <TextBlock Text="系统" FontSize="12" FontWeight="SemiBold" Opacity="0.55"
                                   Margin="0,12,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <CheckBox x:Name="PortableCheck" Content="便携模式（数据存到程序目录）"
                                  FontSize="13" Margin="0,0,0,8"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </StackPanel>

                <!-- 底部按钮：与编辑窗同款节奏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="关闭" Width="90" Height="34" Margin="0,0,8,0"
                            Click="OnClose" />
                    <Button Content="保存" Width="90" Height="34"
                            Background="DodgerBlue" Foreground="White"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
