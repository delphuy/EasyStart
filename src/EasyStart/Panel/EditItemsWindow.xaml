<Window x:Class="EasyStart.Panel.EditItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑快捷项"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="OnWinKeyDown">
    <!-- 外层 Margin 给投影留空间；弹窗浮在主面板上方，四边露出面板（辉哥哥：层次要分明） -->
    <Grid Margin="12">
        <Border x:Name="DialogRoot" CornerRadius="12"
                BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundLightBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题（拖动把手） + 右上角 ✕ 关闭 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="编辑快捷项" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <TextBlock Text="  ·  勾选后可批量删除 / 整块移动，操作即时保存" FontSize="11" Opacity="0.5"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1" Content="✕" Width="30" Height="28"
                            FontSize="13" Padding="0" ToolTip="关闭（Esc）"
                            Click="OnCloseRequest" />
                </Grid>

                <!-- 主区：左页签列表 + 右快捷项清单 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：页签列表（行内边距统一，行间距 4，不再贴边挤成一坨） -->
                    <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <ListBox x:Name="TabList" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Margin" Value="4,2" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <!-- 右：清单 + 工具栏 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏：左计数，右 4 个图标按钮（删除 / ↑上移 / ↓下移 / 添加） -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Opacity="0.75"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DeleteBtn" Width="36" Height="30" Margin="4,0,0,0" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Content="&#xE74D;" ToolTip="删除勾选项（批量）"
                                        IsEnabled="False" Click="OnDelete" />
                                <Button x:Name="MoveUpBtn" Width="36" Height="30" Margin="4,0,0,0" Padding="0"
                                        FontSize="16" Content="↑" ToolTip="上移：勾选项整体向前挪一位"
                                        IsEnabled="False" Click="OnMoveUp" />
                                <Button x:Name="MoveDownBtn" Width="36" Height="30" Margin="4,0,0,0" Padding="0"
                                        FontSize="16" Content="↓" ToolTip="下移：勾选项整体向后挪一位"
                                        IsEnabled="False" Click="OnMoveDown" />
                                <Button x:Name="AddBtn" Width="36" Height="30" Margin="10,0,0,0" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Background="DodgerBlue" Foreground="White"
                                        Content="&#xE710;" ToolTip="添加快捷项（选程序 / 系统功能 / 自定义）"
                                        Click="OnAdd" />
                            </StackPanel>
                        </Grid>

                        <!-- 右：5 栏位清单（勾选框 / 图标 / 名称 / 类型 / 路径） -->
                        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <ListView x:Name="ItemList" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="44">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                                           VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="160" Header="名称">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding NameText}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip="{Binding NameText}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="64" Header="类型">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TypeText}" FontSize="12" Opacity="0.75"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="230" Header="路径">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PathText}" FontSize="12" Opacity="0.75"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip="{Binding PathText}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 底部 -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="DoneBtn" Content="完成" Width="88" Height="34"
                            Background="DodgerBlue" Foreground="White"
                            HorizontalAlignment="Right" Click="OnDone" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
