<Window x:Class="EasyStart.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyStart.Panel"
        Title="EasyStart"
        Width="956" Height="600"
        MinWidth="420" MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        Deactivated="OnDeactivated"
        Closed="OnClosed"
        PreviewMouseRightButtonUp="OnPanelPreviewMouseRightButtonUp"
         SizeChanged="OnSizeChanged">


    <!-- Mica 窗口背景（Win11 原生 DWM 材质，老系统自动降级纯色，由 ThemeService 在代码后置应用） -->
    <Border x:Name="RootBorder"
            CornerRadius="8"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 标题拖动区（面板移动把手） -->
                <RowDefinition Height="36" />
                <!-- 标签条（页签 + + 号跟随页签末尾，P1-F1 随增删移动） -->
                <RowDefinition Height="Auto" />
                <!-- 图标网格 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题拖动区（P1-F8 面板可拖动）：整块 MouseDown 调 DragMove；文字色由 ThemeService 按主题设置 -->
            <Border x:Name="DragArea" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown"
                    Cursor="SizeNWSE">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="TitleLabel" Text="EasyStart" FontSize="13" FontWeight="SemiBold" Opacity="0.55"
                               Foreground="#202020" />
                    <TextBlock x:Name="TitleHint" Text="  ·  按住拖动面板" FontSize="11" Opacity="0.4"
                               Foreground="#5A5A5A" />
                </StackPanel>
            </Border>

            <!-- 标签条：页签胶囊 + + 号（P1-F1 +号跟随页签末尾，无底色，随增删移动） -->
            <Grid Grid.Row="1" Margin="16,4,16,8">
                <ItemsControl x:Name="TabStrip"
                               AllowDrop="True"
                               DragOver="OnTabStripDragOver"
                               Drop="OnTabStripDrop"
                               VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="TabRow" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- 图标网格（P1-F6 紧凑排版：固定行间距 + 左右对称 padding + 窗口缩放动态列数） -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,6,12,6">
                <ItemsControl x:Name="ItemHost" />
            </ScrollViewer>

            <!-- 蒙版：编辑弹窗打开时压暗面板内容，避免面板干扰弹窗（辉哥哥反馈）；toast 在外层，不受影响 -->
            <Border x:Name="ModalScrim" Grid.Row="0" Grid.RowSpan="3"
                    Background="#88000000" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
